generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ── Tenancy and authentication ─────────────────────────────────────────────
//
// Retainify began as a Shopify-only app, where the shop domain WAS the identity
// and Shopify handled who you are. Running outside Shopify means owning both.
//
// ── Why `key` rather than an accountId foreign key everywhere ───────────────
// Twenty-seven tables already carry a `shop String` tenant column. Rather than
// add an accountId to all of them and migrate live data, an Account holds the
// exact value those rows already store: for a Shopify install that is
// "store.myshopify.com", for a direct signup it is a generated slug. The column
// simply stops meaning "a myshopify domain" and starts meaning "a workspace
// key". Zero data movement, and every existing query keeps working untouched.
model Account {
  id        String   @id @default(cuid())
  // The tenant key. Matches the `shop` column on every data table.
  key       String   @unique
  name      String
  // How this workspace was created. A shopify account is billed by Shopify and
  // gets commerce features; a direct account is billed by us (later) and sees
  // commerce features hidden rather than broken.
  kind      String   @default("direct") // direct | shopify
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  invites     Invite[]
  sessions    AuthSession[]

  @@index([kind])
}

// A person. Distinct from Account: one person can belong to several workspaces
// (the whole point here — one operator running several businesses).
model User {
  id              String    @id @default(cuid())
  email           String    @unique // lowercased on write
  name            String    @default("")
  // scrypt, via node:crypto — see lib/auth/password.server.js. Null for a user
  // created by invite who has not yet set a password.
  passwordHash    String?
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships Membership[]
  sessions    AuthSession[]
  invitesSent Invite[]      @relation("InvitedBy")
}

// Which workspaces a user can reach, and with what rights.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  accountId String
  role      String   @default("member") // owner | admin | member
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
  @@index([accountId])
}

// Our own login sessions. Deliberately NOT the `Session` model above — that one
// belongs to the Shopify SDK and stores an access token, and conflating the two
// would let a bug in one become an auth bypass in the other.
//
// `tokenHash` is stored, never the token: a leaked database must not yield
// usable session cookies.
model AuthSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  // Which workspace this session is currently looking at. Nullable so a user
  // between workspaces (or with none yet) still has a valid session.
  accountId  String?
  userAgent  String   @default("")
  ip         String   @default("")
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
}

// Pending team invitation. Also the password-reset carrier — same shape, same
// expiry semantics, so one table and one consume path rather than two.
model Invite {
  id              String    @id @default(cuid())
  accountId       String?
  email           String // lowercased
  role            String    @default("member")
  kind            String    @default("invite") // invite | password_reset | verify_email
  tokenHash       String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  invitedByUserId String?
  createdAt       DateTime  @default(now())

  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  invitedBy User?    @relation("InvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([accountId])
  @@index([expiresAt])
}

// Per-shop configuration for the Cart Rescue journey
model ShopSettings {
  id                                 String    @id @default(cuid())
  shop                               String    @unique
  senderName                         String    @default("Your Store")
  senderEmail                        String    @default("")
  replyTo                            String    @default("")
  emailProvider                      String    @default("resend") // resend | ses
  brandColor                         String    @default("#000000")
  logoUrl                            String    @default("")
  // The workspace's public website. For a Shopify install this is derivable
  // from the shop domain, so it stays empty unless overridden; a direct
  // workspace has no such domain and must supply one, or {store_url} — which is
  // also the fallback target for any email button left without a URL — has
  // nowhere to point.
  websiteUrl                         String    @default("")
  quietHoursStart                    Int       @default(22) // hour 0-23 in store timezone
  quietHoursEnd                      Int       @default(8)
  storeTimezone                      String    @default("UTC")
  // Domain verification (Resend custom sending domain, Mode A)
  verifiedDomain                     String    @default("") // the domain name, e.g. "theirbrand.com"
  domainVerified                     Boolean   @default(false) // true only when Resend status == "verified"
  resendDomainId                     String    @default("") // Resend domain UUID
  domainStatus                       String    @default("") // "" | pending | verified | failed
  domainRecords                      String    @default("") // JSON: DNS records to display (cached from create)
  // Onboarding
  onboardingStep                     Int       @default(0) // 0=not started, 1=sender saved, 2=done
  isActive                           Boolean   @default(false)
  // Per-task onboarding/setup-guide state. Shape: { done: { [taskId]: true },
  // skipped: { [taskId]: true } }. Auto-detected tasks (sender/popup/flow) are
  // derived from real data at read time; manual tasks (store/embed/call) live here.
  onboardingProgress                 Json?
  pushEnabled                        Boolean   @default(false)
  // WhatsApp channel (Meta Cloud API). Off by default; flipped on per shop
  // once the merchant connects a WABA via Embedded Signup and approval lands.
  whatsappEnabled                    Boolean   @default(false)
  whatsappProvider                   String    @default("meta") // meta | (future BSP)
  // When true (default, Meta-compliant), WhatsApp only sends to confirmed
  // opt-ins. When a merchant explicitly disables this, the worker will send to
  // any enrolled contact that has a phone number (opt-outs/suppression are
  // ALWAYS honored regardless of this flag).
  whatsappRequireOptIn               Boolean   @default(true)
  // Contacts feature — one-time backfill flag + Shopify customer sync state
  contactsBackfilledAt               DateTime?
  lastShopifyCustomerSyncAt          DateTime?
  shopifyCustomerSyncCursor          String?
  shopifyCustomerSyncStatus          String    @default("idle") // idle | running | failed
  shopifyCustomerSyncTotal           Int?
  shopifyCustomerSyncDone            Int?
  shopifyCustomerSyncIncludeNonOptIn Boolean   @default(false)
  shopifyCustomerSyncLastError       String    @default("")
  // Segments feature — daily snapshot worker. No-op unless ≥24h elapsed.
  lastSegmentSnapshotAt              DateTime?
  // Historical order backfill. Resumable: the cursor lets a shop with years of
  // orders be processed across several passes instead of one request that
  // times out. ordersBackfilledAt is set only on completion.
  ordersBackfilledAt                 DateTime?
  ordersBackfillCursor               String?
  ordersBackfillStatus               String    @default("idle") // idle | running | done | failed
  ordersBackfillError                String    @default("")
  createdAt                          DateTime  @default(now())
  updatedAt                          DateTime  @updatedAt
}

// Per-shop billing entitlement. `planKey` is the source of truth for feature
// gating; it mirrors the Shopify subscription and is refreshed from
// billing.check() on app load (throttled — see app/lib/billing/sync.server.js).
//
// Shopify hosts the plan-selection page and owns charging, trials, proration and
// dunning (Shopify App Pricing). This table is our local read-model of that —
// never the authority on whether money changed hands.
model ShopPlan {
  id               String    @id @default(cuid())
  shop             String    @unique
  planKey          String    @default("free") // free | starter | growth | comped
  // Shopify's subscription identity, kept for reconciliation and support debugging.
  subscriptionGid  String    @default("")
  subscriptionName String    @default("")
  status           String    @default("active") // active | pending | cancelled | frozen | expired
  // Grandfathering: comped shops get full access regardless of planKey limits.
  // compedUntil is a real date (30-day window) — getEntitlement() treats an
  // elapsed date as no longer comped, evaluated at READ time so there's no
  // window where a stale row grants access it shouldn't.
  isComped         Boolean   @default(false)
  compedReason     String    @default("")
  compedUntil      DateTime? // null = indefinite
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  lastCheckedAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([planKey])
}

// Monthly send counters per shop. One row per shop per period, so a rollover is
// a new row rather than a destructive reset — keeps history for support and for
// spotting abuse.
model UsageCounter {
  id           String   @id @default(cuid())
  shop         String
  periodStart  DateTime // UTC month start (see periodStartFor)
  emailsSent   Int      @default(0)
  pushSent     Int      @default(0)
  whatsappSent Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([shop, periodStart])
  @@index([shop, periodStart])
}

// Unified contact record per shop+email. Source of truth for browsing audience.
// Other tables (AbandonedCart, PopupSignup, PushSubscription, EmailSuppression,
// JourneyEnrollment) still key on `email` string — no FKs added.
model Contact {
  id                 String    @id @default(cuid())
  shop               String
  email              String // always lowercased + trimmed on write
  name               String    @default("")
  firstSeenAt        DateTime  @default(now())
  lastSeenAt         DateTime  @default(now())
  source             String    @default("manual") // popup | cart_abandoned | shopify_customer | csv_import | push_only | manual
  subscriptionStatus String    @default("never_opted_in") // subscribed | unsubscribed | bounced | complained | never_opted_in
  marketingConsentAt DateTime?
  shopifyCustomerId  String?
  // WhatsApp facets — phone is E.164, whatsappStatus is a separate consent axis
  // from email subscriptionStatus (a contact can be email-subscribed but not
  // WhatsApp-opted-in, or vice versa). WhatsappSubscription holds the detail.
  phone              String?
  whatsappStatus     String    @default("never_opted_in") // subscribed | unsubscribed | invalid | never_opted_in
  whatsappOptInAt    DateTime?
  // ── Purchase facts, denormalized from Order ────────────────────────────
  // Kept on the contact rather than aggregated per query because segment
  // evaluation compares them across the whole audience; as columns they are
  // indexable and translate straight into a Prisma WHERE, where a per-contact
  // SUM would force the evaluator's slow JS path over every row.
  // Maintained by recalcContactOrderStats() on every order write.
  orderCount         Int       @default(0)
  totalSpent         Float     @default(0)
  firstOrderAt       DateTime?
  lastOrderAt        DateTime?
  // Merchant-defined properties, keyed by ContactPropertyDef.key. Stored as
  // JSONB rather than one column per field so a merchant can add a property
  // without a migration; the definitions table gives the keys type and meaning.
  // Values are coerced to the declared type on write (see properties.server.js),
  // so a numeric property is always a number here and can be compared as one.
  customProps        Json?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tags ContactTag[]

  @@unique([shop, email])
  // GIN index for the merchant-defined property bag. Declared here rather than
  // only in SQL so `prisma migrate dev` doesn't generate a migration dropping
  // it — a hand-written index the datamodel doesn't know about reads as drift.
  @@index([customProps(ops: JsonbOps)], type: Gin)
  @@index([shop, lastSeenAt])
  @@index([shop, source])
  @@index([shop, subscriptionStatus])
  @@index([shop, whatsappStatus])
  @@index([shop, lastOrderAt])
  @@index([shop, totalSpent])
}

// Merchant-defined tag — per shop. `nameKey` is the lowercased uniqueness key;
// `name` keeps original display case.
model Tag {
  id        String   @id @default(cuid())
  shop      String
  name      String
  nameKey   String
  color     String   @default("forest") // forest | blue | amber | purple | tan | red
  createdAt DateTime @default(now())

  contacts ContactTag[]

  @@unique([shop, nameKey])
}

// Join table — tag membership on a contact.
model ContactTag {
  contactId String
  tagId     String
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([tagId])
}

// Merchant-defined contact property. The schema for one key inside
// Contact.customProps — label, type, and (for select) its allowed options.
//
// `key` is the stable machine name used in the JSON bag, in CSV import mapping,
// and in segment rules. It is generated from the label once and never changes,
// so renaming a property in the UI cannot orphan the stored values.
model ContactPropertyDef {
  id        String   @id @default(cuid())
  shop      String
  key       String // snake_case, immutable once created
  label     String // display name, freely editable
  type      String   @default("text") // text | number | date | boolean | select
  options   Json? // for type = "select": array of allowed string values
  position  Int      @default(0) // display order in the UI
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, key])
  @@index([shop, position])
}

// A saved view of the Contacts table: which filters are applied, which columns
// are shown and in what order. Lets a merchant keep "VIP buyers" or "Needs
// re-engagement" one click away instead of rebuilding filters each visit.
model ContactView {
  id        String   @id @default(cuid())
  shop      String
  name      String
  // { status, source, tagId, search } plus any custom-property filters.
  filters   Json?
  // Ordered array of column keys — built-ins ("email", "status", …) and
  // custom-property keys prefixed "prop:".
  columns   Json?
  isDefault Boolean  @default(false) // opened automatically on arrival
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop, position])
}

// An uploaded file in the shop's content library.
//
// The bytes live in Shopify Files (see lib/shopify/files.server.js); this is a
// local index of them. Keeping our own row is what makes the library listable,
// searchable and attributable — the Files API cannot tell us which uploads came
// from this app — and it gives alt text somewhere to live.
model MediaAsset {
  id         String   @id @default(cuid())
  shop       String
  url        String // Shopify CDN URL, the shareable link
  shopifyGid String   @default("") // Files API id, for later deletion
  filename   String   @default("")
  mimeType   String   @default("")
  byteSize   Int      @default(0)
  width      Int? // images only
  height     Int?
  alt        String   @default("")
  // Where it came from, so the library can show "used in emails" vs one-off
  // uploads: email_block | email_logo | library | popup
  source     String   @default("library")
  createdAt  DateTime @default(now())
  // Soft delete. Removing an asset hides it from the library but must not break
  // the image in an email that has already been delivered — an inbox copy is
  // not re-renderable, so the URL has to keep resolving forever.
  deletedAt  DateTime?

  @@index([shop, createdAt])
  @@index([shop, mimeType])
}

// Saved audience group — dynamic (rule tree) or static (explicit member list).
// Used for browsing, and (in a follow-up phase) for flow triggers.
model Segment {
  id             String    @id @default(cuid())
  shop           String
  name           String
  description    String    @default("")
  kind           String // "dynamic" | "static"
  filterTree     Json? // root group for dynamic; null for static
  contactCount   Int       @default(0)
  lastComputedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  memberships SegmentMembership[]

  @@index([shop, deletedAt])
  @@index([shop, updatedAt])
}

// Per-contact entry log for a segment. Powers the segment detail Activity
// tab (Recently entered / left) AND the enrollment worker's diff between
// runs. Both static and dynamic segments write here:
//   - Static: from addStaticMember/removeStaticMember (synchronously).
//   - Dynamic: from the segment enrollment worker on each tick.
// segmentKey matches Segment.id OR a sys_* system segment key.
model SegmentEntryLog {
  id         String    @id @default(cuid())
  shop       String
  segmentKey String
  contactId  String
  enteredAt  DateTime  @default(now())
  leftAt     DateTime?

  @@index([shop, segmentKey, enteredAt])
  @@index([shop, segmentKey, leftAt])
  @@index([contactId])
}

// Daily size snapshot for the Activity tab sparkline. The snapshot worker
// writes one row per segment per UTC day and prunes anything older than 30
// days for that segmentKey.
model SegmentSnapshot {
  id         String   @id @default(cuid())
  shop       String
  segmentKey String
  takenAt    DateTime @default(now())
  count      Int

  @@index([shop, segmentKey, takenAt])
}

// Explicit membership row for static segments. (Dynamic segments don't write
// to this table — they evaluate on read.)
model SegmentMembership {
  id        String   @id @default(cuid())
  segmentId String
  contactId String // points at Contact.id; joined by app logic
  addedAt   DateTime @default(now())

  segment Segment @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@unique([segmentId, contactId])
  @@index([segmentId])
  @@index([contactId])
}

// A placed order, ingested from the orders/create and orders/paid webhooks and
// by the historical backfill.
//
// Exists so the Purchase segment fields (total spent, order count, last order
// date, AOV) can work at all, and so revenue attribution isn't limited to cart
// recovery. Only the facts we actually use are stored — no line items, no
// addresses — because everything here is shopper PII we then have to erase on
// request, and storing what we don't need is pure liability.
model Order {
  id              String    @id @default(cuid())
  shop            String
  shopifyOrderId  String // numeric id as a string, stable across API versions
  email           String // lowercased, links to Contact
  totalPrice      Float     @default(0)
  currency        String    @default("USD")
  financialStatus String    @default("") // paid | pending | refunded | voided | ...
  processedAt     DateTime // when the customer ordered, not when we ingested
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // orders/create and orders/paid both fire for the same order, so the id is
  // the dedupe key rather than a source of duplicates.
  @@unique([shop, shopifyOrderId])
  @@index([shop, email])
  @@index([shop, processedAt])
}

// Tracks an abandoned checkout session
model AbandonedCart {
  id               String    @id @default(cuid())
  shop             String
  checkoutToken    String
  checkoutId       String
  cartToken        String    @default("")
  customerEmail    String
  customerName     String    @default("")
  totalPrice       Float
  currency         String    @default("USD")
  lineItemsJson    String // JSON serialised line items
  recoveryUrl      String
  abandonedAt      DateTime  @default(now())
  recoveredAt      DateTime?
  recoveredRevenue Float?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([shop, checkoutToken])
  @@index([shop, customerEmail])
  @@index([shop, recoveredAt])
}

// Email suppression / unsubscribe list
model EmailSuppression {
  id        String   @id @default(cuid())
  shop      String
  email     String
  reason    String   @default("unsubscribe") // unsubscribe | bounce | complaint
  createdAt DateTime @default(now())

  @@unique([shop, email])
  @@index([shop, email])
}

// Popup signup capture
model PopupSignup {
  id           String    @id @default(cuid())
  shop         String
  email        String
  source       String    @default("exit_intent_popup")
  discountCode String    @default("")
  confirmToken String    @default("")
  confirmedAt  DateTime?
  // Provider message ids for the two transactional emails this row sends, so
  // Resend open/click webhooks can be matched back. Without them the events
  // arrived, matched no JourneyJob, and were discarded.
  confirmMessageId  String   @default("")
  discountMessageId String   @default("")
  openedAt          DateTime?
  clickedAt         DateTime?
  createdAt    DateTime  @default(now())

  @@index([shop, email])
  @@index([confirmMessageId])
  @@index([discountMessageId])
}

// Per-shop popup widget configuration
model PopupSettings {
  id          String   @id @default(cuid())
  shop        String   @unique
  enabled     Boolean  @default(true)
  template    String   @default("editorial")
  config      Json?
  // Legacy columns — kept during storefront rollout, dropped in follow-up migration.
  headline    String   @default("Wait — don't go yet!")
  bodyText    String   @default("Enter your email and get 10% off your first order.")
  buttonText  String   @default("Get my discount")
  brandColor  String   @default("#000000")
  logoUrl     String   @default("")
  discountPct Int      @default(10)
  delayMs     Int      @default(3000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Flexible journey engine — a playbook (welcome, win-back, post-purchase, etc.)
model Journey {
  id                 String    @id @default(cuid())
  shop               String
  name               String
  trigger            String // cart_abandoned | customer_created | order_placed | win_back | segment_entered
  isActive           Boolean   @default(false)
  status             String    @default("draft") // draft | published | paused
  publishedAt        DateTime?
  publishedVersion   Int       @default(0)
  draftVersion       Int       @default(0)
  entryFrequency     String    @default("no_reentry") // immediate | delayed_<hours> | no_reentry
  exitCriteria       String    @default("[]") // JSON array of event keys
  source             String    @default("flows") // flows | automations | cart_rescue_legacy
  archivedAt         DateTime?
  // Segments trigger metadata. triggerSegmentKey holds Segment.id (cuid) or
  // a sys_* key for built-in system segments. lastEnrollmentAt/Hash drive
  // the staggered enrollment worker — never bypass via hand edits.
  triggerSegmentKey  String?
  lastEnrollmentAt   DateTime?
  lastEnrollmentHash String?
  // ── Broadcast fields (trigger = "broadcast") ───────────────────────────
  // A broadcast is a one-off send rather than an automation: one email, one
  // audience, once. It reuses this model deliberately — the step editor,
  // renderer, job queue, suppression, quiet hours, quota and per-recipient
  // analytics all already operate on a Journey, and a parallel Campaign model
  // would have to duplicate every one of them.
  //
  // The audience is triggerSegmentKey (a Segment id, a sys_* key, or null for
  // every subscribed contact).
  scheduledFor       DateTime? // when to send; null means send on publish
  // Set the moment the audience is enrolled. This is what makes the send
  // exactly-once: the dispatcher claims a broadcast by writing this, so a
  // second worker tick — or a second app instance — cannot enroll twice.
  dispatchedAt       DateTime?
  recipientCount     Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  steps       JourneyStep[]
  enrollments JourneyEnrollment[]

  @@index([shop, trigger])
  @@index([shop, status])
  @@index([trigger, status, lastEnrollmentAt])
  // Drives the broadcast dispatcher's "which sends are due" query.
  @@index([trigger, status, scheduledFor])
}

// One step within a journey (email send, time delay, push, or exit)
model JourneyStep {
  id             String   @id @default(cuid())
  journeyId      String
  stepNumber     Int
  nodeType       String   @default("email") // email | delay | exit | push | whatsapp
  positionY      Int      @default(0)
  delayHours     Float    @default(1)
  subject        String   @default("")
  previewText    String   @default("")
  emailName      String   @default("")
  templateStyle  String   @default("classic")
  discountPct    Int      @default(0)
  isEnabled      Boolean  @default(true)
  // Set when a draft edit replaced this step but in-flight jobs still
  // reference it. Archived steps are excluded from the builder canvas and
  // step counts, but kept so their JourneyJobs are not cascade-deleted.
  isArchived     Boolean  @default(false)
  emailBlocks    String   @default("[]") // JSON array of block objects
  emailBrand     String   @default("{}") // JSON brand kit object
  // Email authoring mode. "blocks" (default) renders emailBlocks/emailBrand via
  // the visual renderer; "html" sends the merchant's pasted emailHtml verbatim
  // (merge tags + unsubscribe still applied at send time).
  emailMode      String   @default("blocks") // blocks | html
  emailHtml      String   @default("") // raw pasted HTML (used when emailMode = "html")
  // Push notification fields
  pushTitle      String   @default("")
  pushBody       String   @default("")
  pushIconUrl    String   @default("")
  pushClickUrl   String   @default("")
  // WhatsApp fields — references a Meta-approved HSM template by name+language.
  // waVariables maps positional template params ({{1}},{{2}}...) to a merge-tag
  // or enrollment-payload key resolved at send time.
  waTemplateName String   @default("")
  waLanguage     String   @default("")
  waVariables    Json?
  waMediaUrl     String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  journey      Journey       @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  jobs         JourneyJob[]
  pushJobs     PushJob[]
  whatsappJobs WhatsappJob[]

  @@index([journeyId, stepNumber])
}

// Pre-configured flow templates (seed data)
model JourneyTemplate {
  id          String   @id @default(cuid())
  key         String   @unique // welcome_series | abandoned_cart | post_purchase | winback
  name        String
  description String   @default("")
  trigger     String
  category    String   @default("") // welcome | cart | post_purchase | winback | special_occasion
  bestFor     String   @default("[]") // JSON array of bullet strings
  definition  String   @default("{}") // JSON: { steps, entryFrequency, exitCriteria }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// One contact enrolled in a journey
model JourneyEnrollment {
  id           String    @id @default(cuid())
  shop         String
  journeyId    String
  contactEmail String
  contactName  String    @default("")
  payload      String    @default("{}")
  enrolledAt   DateTime  @default(now())
  completedAt  DateTime?
  exitReason   String    @default("")

  journey      Journey       @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  jobs         JourneyJob[]
  pushJobs     PushJob[]
  whatsappJobs WhatsappJob[]

  @@index([shop, contactEmail])
  @@index([journeyId])
}

// Scheduled send per step per enrollment
model JourneyJob {
  id                String    @id @default(cuid())
  shop              String
  enrollmentId      String
  stepId            String
  scheduledFor      DateTime
  status            String    @default("pending")
  attempts          Int       @default(0)
  lastError         String    @default("")
  // First failure for this job, so the transient retry horizon is a real
  // wall-clock deadline rather than an attempt count. Null = never failed.
  firstFailedAt     DateTime?
  resendMessageId   String    @default("")
  providerMessageId String    @default("")
  sentAt            DateTime?
  // Provider-confirmed outcomes, distinct from sentAt. sentAt means "Resend
  // accepted the call"; a message can still fail or bounce afterwards, and
  // without these a failed send is indistinguishable from a delivered one in
  // every report.
  deliveredAt       DateTime?
  failedAt          DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  enrollment JourneyEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  step       JourneyStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([shop, enrollmentId])
  @@index([resendMessageId])
  @@index([providerMessageId])
}

// Browser push subscriptions — one row per browser per shop
model PushSubscription {
  id             String    @id @default(cuid())
  shop           String
  endpoint       String
  p256dh         String
  auth           String
  contactEmail   String?
  anonId         String?
  isActive       Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  @@unique([shop, endpoint])
  @@index([shop, contactEmail])
  @@index([shop, anonId])
}

// Scheduled push notification per push step per enrollment
model PushJob {
  id           String    @id @default(cuid())
  shop         String
  enrollmentId String
  stepId       String
  scheduledFor DateTime
  status       String    @default("pending") // pending | processing | done | failed | cancelled
  attempts     Int       @default(0)
  lastError    String    @default("")
  // First failure for this job, so the transient retry horizon is a real
  // wall-clock deadline rather than an attempt count. Null = never failed.
  firstFailedAt     DateTime?
  sentAt       DateTime?
  // Set by /track/push-click, which the service worker calls from its
  // notificationclick handler. Before this column existed the UI reported
  // "push clicks" as COUNT(status = 'done') — i.e. the number of pushes SENT —
  // which rendered a 100% click-through rate for every contact.
  clickedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  enrollment JourneyEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  step       JourneyStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([shop, enrollmentId])
  @@index([shop, clickedAt])
}

// Per-shop WhatsApp Business Account, connected via Meta Embedded Signup.
// accessTokenEnc is AES-256-GCM ciphertext (see app/lib/crypto/secrets.server.js)
// — the long-lived system-user token is never stored in plaintext.
model WhatsappAccount {
  id                 String    @id @default(cuid())
  shop               String    @unique
  wabaId             String    @default("")
  phoneNumberId      String    @default("")
  displayPhoneNumber String    @default("")
  businessId         String    @default("")
  accessTokenEnc     String    @default("")
  status             String    @default("pending") // pending | connected | disconnected
  connectedAt        DateTime?
  // Cloud API registration (POST /{phoneNumberId}/register). A number must be
  // registered before it can send ANY message (template or free-text); without
  // it Meta returns error #133010 "Account not registered".
  registeredAt       DateTime?
  lastError          String    @default("")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Meta-approved message templates (HSM) synced from a shop's WABA.
model WhatsappTemplate {
  id             String    @id @default(cuid())
  shop           String
  name           String
  language       String
  category       String    @default("MARKETING") // MARKETING | UTILITY | AUTHENTICATION
  metaTemplateId String    @default("")
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED | DISABLED
  bodyText       String    @default("")
  components     Json? // raw Meta component spec, used to map variables
  lastSyncedAt   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([shop, name, language])
  @@index([shop, status])
}

// WhatsApp opt-in record — one row per phone per shop. Mirrors PushSubscription's
// contactEmail linkage back into the Contact graph.
model WhatsappSubscription {
  id            String    @id @default(cuid())
  shop          String
  phoneNumber   String // E.164
  contactEmail  String?
  status        String    @default("subscribed") // subscribed | unsubscribed | invalid
  optInMethod   String? // popup | checkout | click_to_wa | imported | api
  confirmedAt   DateTime? // double opt-in confirmation
  lastInboundAt DateTime? // last customer-initiated message — drives 24h session window
  optInAt       DateTime  @default(now())
  optOutAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([shop, phoneNumber])
  @@index([shop, contactEmail])
}

// Scheduled WhatsApp send per whatsapp step per enrollment. Mirrors PushJob.
model WhatsappJob {
  id                String    @id @default(cuid())
  shop              String
  enrollmentId      String
  stepId            String
  scheduledFor      DateTime
  status            String    @default("pending") // pending | processing | done | failed | cancelled
  attempts          Int       @default(0)
  lastError         String    @default("")
  // First failure for this job, so the transient retry horizon is a real
  // wall-clock deadline rather than an attempt count. Null = never failed.
  firstFailedAt     DateTime?
  templateName      String    @default("")
  providerMessageId String    @default("") // Meta wamid — matched by the status webhook
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  enrollment JourneyEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  step       JourneyStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([shop, enrollmentId])
  @@index([providerMessageId])
}

// Suppression list for WhatsApp — parallel to EmailSuppression.
model WhatsappSuppression {
  id          String   @id @default(cuid())
  shop        String
  phoneNumber String
  reason      String // opt_out | blocked | invalid
  createdAt   DateTime @default(now())

  @@unique([shop, phoneNumber])
}
